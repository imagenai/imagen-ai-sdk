<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.imagen-ai</groupId>
  <artifactId>imagen-ai-sdk</artifactId>
  <version>1.2.0</version>
  <packaging>jar</packaging>

  <name>Imagen AI Java SDK</name>
  <description>Java SDK for the Imagen AI photo-editing API.</description>
  <url>https://github.com/imagenai/imagen-ai-sdk</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Imagen AI</name>
      <email>dev@imagen-ai.com</email>
      <organization>Imagen AI</organization>
      <organizationUrl>https://imagen-ai.com</organizationUrl>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/imagenai/imagen-ai-sdk.git</connection>
    <developerConnection>scm:git:git@github.com:imagenai/imagen-ai-sdk.git</developerConnection>
    <url>https://github.com/imagenai/imagen-ai-sdk</url>
  </scm>

  <properties>
    <maven.compiler.release>17</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <jackson.version>2.18.2</jackson.version>
  </properties>

  <dependencies>
    <!-- The only runtime dependency: Java has no standard-library JSON, and a
         hand-rolled parser is exactly the wheel not worth reinventing. HTTP uses
         java.net.http (JDK 11+), so no HTTP client dependency is needed. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <version>${jackson.version}</version>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.11.3</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
    </plugins>
  </build>

  <!-- Activated with `-Prelease` for a Central publish. Kept out of the default
       build so ordinary `mvn test` (CI, contributors) needs no GPG key or
       sources/javadoc jars. Maven Central requires signed jar + sources +
       javadoc; the central-publishing plugin uploads the bundle. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.1</version>
            <configuration>
              <doclint>none</doclint>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
            <configuration>
              <!-- Non-interactive signing in CI: passphrase from env
                   MAVEN_GPG_PASSPHRASE, loopback pinentry so gpg never prompts. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
          </plugin>

          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.7.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- Credentials come from the `central` server in settings.xml
                   (CI provides it from the CENTRAL_TOKEN_* secrets). -->
              <publishingServerId>central</publishingServerId>
              <!-- Auto-release once validation passes; set false to require a
                   manual "Publish" click in the Central Portal for the first run. -->
              <autoPublish>true</autoPublish>
              <waitUntil>published</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
